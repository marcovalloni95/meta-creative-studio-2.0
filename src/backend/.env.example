# Porta su cui gira l'API
PORT=4000

# Origine consentita per CORS (frontend dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Chiave per il modello immagine AI (non necessaria in modalita mock)
GEMINI_API_KEY=

# Chiave Anthropic (console.anthropic.com, diversa dall'abbonamento claude.ai)
# usata per il riepilogo intelligente del documento brief caricato.
# Se assente, il riepilogo usa un fallback euristico (meno accurato).
ANTHROPIC_API_KEY=

# Se true, forza l'uso del mock anche se GEMINI_API_KEY e' presente
FORCE_MOCK_IMAGE_GENERATION=true
